<%- include('_header') %>
<h1 data-testid="asset-name"><%= asset.name %></h1>
<dl class="details-grid" data-testid="asset-fields">
  <dt>Category</dt><dd><%= asset.category %></dd>
  <dt>Serial / key</dt><dd><%= asset.serial_or_key %></dd>
  <dt>Model</dt><dd><%= asset.model || '' %></dd>
  <dt>Status</dt><dd data-testid="asset-status"><span class="status status-<%= asset.status %>"><%= asset.status %></span></dd>
  <dt>Assigned to</dt><dd><%= asset.assigned_to || '' %></dd>
  <dt>Notes</dt><dd><%= asset.notes || '' %></dd>
  <dt>Created</dt><dd><%= asset.created_at %></dd>
  <dt>Updated</dt><dd><%= asset.updated_at %></dd>
</dl>

<section class="audit" data-testid="audit-section">
  <h2>Recent activity</h2>
  <% if (audit) { %>
    <p data-testid="audit-entry"><strong><%= audit.created_at %></strong> — <%= audit.action %>: <%= audit.description %></p>
  <% } else { %>
    <p data-testid="audit-empty">No activity recorded yet.</p>
  <% } %>
</section>

<section class="actions" data-testid="actions">
  <% if (asset.status === 'in-stock') { %>
    <form method="post" action="/assets/<%= asset.id %>/assign" class="inline">
      <label>Assign to <input type="text" name="assigned_to" required data-testid="assign-input" /></label>
      <button type="submit" class="btn primary" data-testid="action-assign">Assign</button>
    </form>
  <% } else if (asset.status === 'assigned' || asset.status === 'returned') { %>
    <form method="post" action="/assets/<%= asset.id %>/return" class="inline" data-testid="form-return">
      <button type="submit" class="btn" data-testid="action-return">Mark returned</button>
    </form>
    <form method="post" action="/assets/<%= asset.id %>/lost" class="inline" data-testid="form-lost">
      <button type="submit" class="btn warn" data-testid="action-lost">Mark lost</button>
    </form>
    <% if (asset.status === 'returned') { %>
      <form method="post" action="/assets/<%= asset.id %>/assign" class="inline">
        <label>Re-assign to <input type="text" name="assigned_to" required data-testid="reassign-input" /></label>
        <button type="submit" class="btn primary" data-testid="action-reassign">Assign</button>
      </form>
    <% } %>
  <% } else if (asset.status === 'lost') { %>
    <p class="muted">This asset is marked lost and cannot be transitioned.</p>
  <% } %>
</section>

<p><a href="/assets" data-testid="back-to-list">Back to list</a></p>
<%- include('_footer') %>