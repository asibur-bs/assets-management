<span class="password-field">
  <input type="password" name="<%= name %>" <%= isRequired ? 'required' : '' %> autocomplete="<%= autocomplete %>" data-testid="<%= testid %>" />
  <button type="button" class="password-toggle" data-testid="<%= testid %>-toggle" aria-label="<%= showLabel %>" data-show-label="<%= showLabel %>" data-hide-label="<%= hideLabel %>" aria-pressed="false">
    <svg class="password-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.5 12S6.2 6.5 12 6.5 21.5 12 21.5 12 17.8 17.5 12 17.5 2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/>
    </svg>
    <svg class="password-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3.5 4.5 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M9.4 6.9A10 10 0 0 1 12 6.5c5.8 0 9.5 5.5 9.5 5.5a16 16 0 0 1-3.1 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M6.2 8.3C4.3 9.7 2.9 11.4 2.5 12S6.2 17.5 12 17.5c1.1 0 2.1-.2 3-.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M10 11.3a2.6 2.6 0 0 0 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>
</span>
