<% pageTitle = 'Users'; headerKind = 'users'; listPage = true; %>
<%- include('_header') %>
<div class="list-toolbar">
  <p class="count-line muted" data-testid="user-count"><% if (pagination.matching === 0) { %>Showing 0 of 0 users<% } else { %>Showing <%= pagination.rangeStart %>–<%= pagination.rangeEnd %> of <%= pagination.matching %> users<% } %></p>
  <div class="list-actions">
    <a class="btn primary" href="/users/new" data-testid="user-new">New user</a>
  </div>
</div>
<p class="muted list-note">People who can sign in. Assets are assigned from the People directory.</p>
<div class="table-scroll">
<table class="asset-table" data-testid="user-table">
  <thead>
    <tr>
      <th>Username</th>
      <th>Display name</th>
      <th>Role</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(function (user) { %>
      <tr data-testid="user-row-<%= user.username %>">
        <td><%= user.username %></td>
        <td><%= user.displayName %></td>
        <td><%= user.role === 'administrator' ? 'Administrator' : 'Reader' %></td>
        <td><%= user.disabledAt ? 'Disabled' : 'Active' %></td>
        <td class="row-actions"><a class="row-edit" href="/users/<%= user.id %>/edit" data-testid="user-edit-<%= user.username %>" aria-label="Edit" title="Edit"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h4l10.5-10.5-4-4L4 16v4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m13.5 6.5 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></a></td>
      </tr>
    <% }); %>
  </tbody>
</table>
</div>
<%- include('_pagination') %>
<%- include('_footer') %>
