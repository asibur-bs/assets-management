<% pageTitle = 'Assets'; headerKind = 'assets'; %>
<%- include('_header') %>
<form method="get" action="/assets" class="filters asset-filters" data-testid="filters">
  <label class="field">Search
    <input type="search" name="search_text" placeholder="Search name or serial" value="<%= filters.search_text %>" data-testid="filter-search-text" />
  </label>
  <label class="field">Category
    <select name="category" data-testid="filter-category">
      <option value="">All categories</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Status
    <select name="status" data-testid="filter-status">
      <option value="">All statuses</option>
      <% statuses.forEach(function (status) { %>
        <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Sort
    <select name="sort_column" data-testid="filter-sort-column">
      <% sortColumns.forEach(function (column) { %>
        <option value="<%= column.value %>" <%= filters.sort_column === column.value ? 'selected' : '' %>><%= column.label %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Direction
    <select name="sort_direction" data-testid="filter-sort-direction">
      <% sortDirections.forEach(function (direction) { %>
        <option value="<%= direction.value %>" <%= filters.sort_direction === direction.value ? 'selected' : '' %>><%= direction.label %></option>
      <% }); %>
    </select>
  </label>
  <% if (filters.holder) { %>
    <input type="hidden" name="holder" value="<%= filters.holder %>" />
  <% } %>
  <div class="filter-actions">
    <button type="submit" class="btn primary" data-testid="filter-apply">Apply</button>
    <a class="btn" href="/assets" data-testid="filter-reset">Reset</a>
  </div>
</form>
<% if (filters.holder) { %>
  <p class="count-line" data-testid="active-holder">Holder <%= filters.holder %></p>
<% } %>
<% if (matching === 0) { %>
  <p class="count-line muted" data-testid="count-line">Showing 0 of 0 records</p>
<% } else { %>
  <p class="count-line muted" data-testid="count-line">Showing <%= pagination.rangeStart %>–<%= pagination.rangeEnd %> of <%= matching %> records</p>
<% } %>

<div class="table-scroll">
<table class="asset-table" data-testid="asset-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Category</th>
      <th>Serial / Key</th>
      <th>Status</th>
      <th>Holder</th>
      <th>Last holder</th>
    </tr>
  </thead>
  <tbody>
    <% if (assets.length === 0) { %>
      <tr class="empty"><td colspan="6" data-testid="empty-row">No assets yet.</td></tr>
    <% } else { %>
      <% assets.forEach(function (asset) { %>
        <tr data-testid="asset-row-<%= asset.id %>">
          <td><a href="/assets/<%= asset.id %>" data-testid="asset-link-<%= asset.id %>"><%= asset.name %></a></td>
          <td><%= asset.category %></td>
          <td><%= asset.serial_or_key %></td>
          <td><span class="status status-<%= asset.status %>" data-testid="status-<%= asset.id %>"><%= statusLabel(asset.status) %></span></td>
          <td data-testid="holder-<%= asset.id %>"><%= showValue(asset.assigned_to) %></td>
          <td data-testid="last-holder-<%= asset.id %>"><%= showValue(asset.last_assigned_to) %></td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>
</div>
<% if (pagination.pageCount > 1) { %>
<nav class="pagination" aria-label="Asset pages" data-testid="pagination">
  <% if (pagination.prevHref) { %>
    <a class="btn" href="<%= pagination.prevHref %>" data-testid="page-prev" rel="prev">Previous</a>
  <% } else { %>
    <span class="btn is-disabled" aria-disabled="true" data-testid="page-prev">Previous</span>
  <% } %>
  <% pagination.pages.forEach(function (item) { %>
    <% if (item.ellipsis) { %>
      <span class="ellipsis" aria-hidden="true">…</span>
    <% } else { %>
      <a class="btn<%= item.current ? ' current' : '' %>" href="<%= item.href %>" data-testid="page-<%= item.page %>"<% if (item.current) { %> aria-current="page"<% } %>><%= item.page %></a>
    <% } %>
  <% }); %>
  <% if (pagination.nextHref) { %>
    <a class="btn" href="<%= pagination.nextHref %>" data-testid="page-next" rel="next">Next</a>
  <% } else { %>
    <span class="btn is-disabled" aria-disabled="true" data-testid="page-next">Next</span>
  <% } %>
  <span class="page-status" data-testid="page-status">Page <%= pagination.page %> of <%= pagination.pageCount %></span>
</nav>
<% } %>
<p class="legend" data-testid="status-legend">Legend:
  <% statuses.forEach(function (status) { %>
    <span class="status status-<%= status %>"><%= statusLabel(status) %></span>
  <% }); %>
</p>
<%- include('_footer') %>
