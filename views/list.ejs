<% pageTitle = 'Assets'; headerKind = 'assets'; %>
<%- include('_header') %>
<dialog id="asset-filters" class="filter-dialog" aria-labelledby="filter-dialog-title">
<form method="get" action="/assets" class="filters asset-filters" data-testid="filters">
  <div class="dialog-head filter-dialog-head">
    <h2 id="filter-dialog-title">Filters</h2>
    <%- include('_dialog-close') %>
  </div>
  <input type="hidden" name="search_text" value="<%= filters.search_text %>" data-asset-search-value />
  <label class="field">Category
    <select name="category" data-testid="filter-category">
      <option value="">All categories</option>
      <% categories.forEach(function (category) { %>
        <option value="<%= category %>" <%= filters.category === category ? 'selected' : '' %>><%= category %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Status
    <select name="status" data-testid="filter-status">
      <option value="">All statuses</option>
      <% statuses.forEach(function (status) { %>
        <option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= statusLabel(status) %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Sort
    <select name="sort_column" data-testid="filter-sort-column">
      <% sortColumns.forEach(function (column) { %>
        <option value="<%= column.value %>" <%= filters.sort_column === column.value ? 'selected' : '' %>><%= column.label %></option>
      <% }); %>
    </select>
  </label>
  <label class="field">Direction
    <select name="sort_direction" data-testid="filter-sort-direction">
      <% sortDirections.forEach(function (direction) { %>
        <option value="<%= direction.value %>" <%= filters.sort_direction === direction.value ? 'selected' : '' %>><%= direction.label %></option>
      <% }); %>
    </select>
  </label>
  <% if (filters.holder) { %>
    <input type="hidden" name="holder" value="<%= filters.holder %>" />
  <% } %>
  <div class="filter-actions">
    <button type="submit" class="btn primary" data-testid="filter-apply">Apply</button>
    <a class="btn" href="/assets" data-testid="filter-reset">Reset</a>
  </div>
</form>
</dialog>
<% if (filters.holder) { %>
  <p class="count-line" data-testid="active-holder">Holder <%= filters.holder %></p>
<% } %>
<div class="list-toolbar">
  <% if (matching === 0) { %>
    <p class="count-line muted" data-testid="count-line">Showing 0 of 0 records</p>
  <% } else { %>
    <p class="count-line muted" data-testid="count-line">Showing <%= pagination.rangeStart %>–<%= pagination.rangeEnd %> of <%= matching %> records</p>
  <% } %>
  <div class="list-actions">
    <form method="get" action="/assets" class="holder-search" data-testid="asset-search-form">
      <span class="search-field">
        <svg class="search-field-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <input type="search" name="search_text" value="<%= filters.search_text %>" placeholder="Search name or serial" aria-label="Search assets" data-testid="filter-search-text" autocomplete="off" />
      </span>
      <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>" /><% } %>
      <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>" /><% } %>
      <% if (filters.sort_column && filters.sort_column !== 'created_at') { %><input type="hidden" name="sort_column" value="<%= filters.sort_column %>" /><% } %>
      <% if (filters.sort_direction && filters.sort_direction !== 'desc') { %><input type="hidden" name="sort_direction" value="<%= filters.sort_direction %>" /><% } %>
      <% if (filters.holder) { %><input type="hidden" name="holder" value="<%= filters.holder %>" /><% } %>
    </form>
    <button type="button" class="btn filter-toggle<%= (filters.search_text || filters.category || filters.status || filters.holder) ? ' is-active' : '' %>" data-open-dialog="asset-filters" data-testid="filter-toggle" aria-haspopup="dialog" aria-label="Filters">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 5.5h16l-6 7.1V19l-4-2v-4.4l-6-7.1Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
    </button>
    <a class="btn" href="/assets/export<%= exportQuery ? '?' + exportQuery : '' %>" data-testid="export-csv">Export CSV</a>
    <% if (canWrite) { %>
      <a class="btn primary" data-testid="nav-new" href="/assets/new">New asset</a>
    <% } %>
  </div>
</div>

<div class="table-scroll">
<table class="asset-table" data-testid="asset-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Category</th>
      <th>Serial / Key</th>
      <th>Status</th>
      <th>Holder</th>
      <th>Last holder</th>
    </tr>
  </thead>
  <tbody>
    <% if (assets.length === 0) { %>
      <tr class="empty"><td colspan="6" data-testid="empty-row">No assets yet.</td></tr>
    <% } else { %>
      <% assets.forEach(function (asset) { %>
        <tr data-testid="asset-row-<%= asset.id %>">
          <td><a href="/assets/<%= asset.id %>" data-testid="asset-link-<%= asset.id %>"><%= asset.name %></a></td>
          <td><%= asset.category %></td>
          <td><%= asset.serial_or_key %></td>
          <td><span class="status status-<%= asset.status %>" data-testid="status-<%= asset.id %>"><%= statusLabel(asset.status) %></span></td>
          <td data-testid="holder-<%= asset.id %>"><%= showValue(asset.assigned_to) %></td>
          <td data-testid="last-holder-<%= asset.id %>"><%= showValue(asset.last_assigned_to) %></td>
        </tr>
      <% }); %>
    <% } %>
  </tbody>
</table>
</div>
<%- include('_pagination') %>
<p class="legend" data-testid="status-legend">Legend:
  <% statuses.forEach(function (status) { %>
    <span class="status status-<%= status %>"><%= statusLabel(status) %></span>
  <% }); %>
</p>
<% if (canWrite) { %>
<div class="import-fab" data-testid="import-fab">
  <div class="import-fab-menu" id="import-actions" data-import-menu hidden>
    <a class="import-fab-action" href="/assets/import/manual" data-testid="import-manual" title="Download import manual" aria-label="Download import manual">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="7.25" fill="none" stroke="currentColor" stroke-width="1.8"/>
        <path d="M12 11v5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M12 8.15h.01" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
      </svg>
    </a>
    <a class="import-fab-action" href="/assets/import/template" data-testid="import-template" title="Download import template" aria-label="Download import template">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 4.5v9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M8.2 10.2 12 14l3.8-3.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 17.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </a>
    <button type="button" class="import-fab-action" data-open-dialog="import-assets" data-testid="import-open" title="Import assets" aria-label="Import assets">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 14.5v-9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        <path d="M8.2 8.8 12 5l3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 17.5h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  <button type="button" class="import-fab-toggle" data-import-toggle data-testid="import-toggle" aria-expanded="false" aria-controls="import-actions" aria-label="Open import actions">
    <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 5.5v13M5.5 12h13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M7 7l10 10M17 7 7 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>
</div>
<dialog id="import-assets" class="filter-dialog" aria-labelledby="import-assets-title">
  <form method="post" action="/assets/import" enctype="multipart/form-data" class="dialog-form">
    <div class="dialog-head">
      <h2 id="import-assets-title">Import assets</h2>
      <%- include('_dialog-close') %>
    </div>
    <p class="muted">Choose an Excel workbook (.xlsx) made from the import template. If any row has a problem, nothing from the file is added.</p>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <label class="field">Workbook
      <input type="file" name="workbook" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required data-testid="import-file" />
    </label>
    <div class="filter-actions">
      <button type="submit" class="btn primary" data-testid="import-submit">Import</button>
    </div>
  </form>
</dialog>
<% } %>
<% if (importReport) { %>
<dialog id="import-report" class="filter-dialog" data-reopen aria-labelledby="import-report-title" data-testid="import-report">
  <div class="dialog-head">
    <h2 id="import-report-title"><%= importReport.title %></h2>
    <%- include('_dialog-close') %>
  </div>
  <p data-testid="import-intro"><%= importReport.intro %></p>
  <% if (importReport.messages && importReport.messages.length) { %>
    <ul class="import-problems" data-testid="import-messages">
      <% importReport.messages.forEach(function (message) { %>
        <li><%= message %></li>
      <% }); %>
    </ul>
  <% } %>
</dialog>
<% } %>
<script>
(function () {
  var input = document.querySelector('[data-testid="filter-search-text"]');
  if (!input) return;
  var mirror = document.querySelector('[data-asset-search-value]');
  if (input.value) {
    input.focus();
    var end = input.value.length;
    if (typeof input.setSelectionRange === 'function') input.setSelectionRange(end, end);
  }
  var timer = null;
  input.addEventListener('input', function () {
    if (mirror) mirror.value = input.value;
    window.clearTimeout(timer);
    timer = window.setTimeout(function () {
      var url = new URL(window.location.href);
      if (input.value.trim()) url.searchParams.set('search_text', input.value);
      else url.searchParams.delete('search_text');
      url.searchParams.delete('page');
      var next = url.pathname + url.search;
      if (next !== window.location.pathname + window.location.search) window.location.assign(next);
    }, 200);
  });
})();
</script>
<% if (canWrite) { %>
<script>
(function () {
  var fab = document.querySelector('[data-testid="import-fab"]');
  if (!fab) return;
  var menu = fab.querySelector('[data-import-menu]');
  var toggle = fab.querySelector('[data-import-toggle]');
  function setOpen(open) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close import actions' : 'Open import actions');
  }
  toggle.addEventListener('click', function () {
    setOpen(menu.hidden);
  });
  fab.addEventListener('click', function (event) {
    event.stopPropagation();
  });
  document.addEventListener('click', function () {
    setOpen(false);
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') setOpen(false);
  });
  var openImport = fab.querySelector('[data-open-dialog="import-assets"]');
  if (openImport) openImport.addEventListener('click', function () { setOpen(false); });
})();
</script>
<% } %>
<%- include('_footer') %>
