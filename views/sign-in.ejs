<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Sign in — Asset Tracker</title>
<script>
(function () {
  var allowed = ['system', 'light', 'dark', 'ocean', 'forest', 'sunset', 'contrast'];
  var stored = 'system';
  try {
    var saved = localStorage.getItem('asset-tracker-theme');
    if (saved && allowed.indexOf(saved) !== -1) stored = saved;
  } catch (err) {
    stored = 'system';
  }
  document.documentElement.setAttribute('data-theme', stored);
})();
</script>
<link rel="stylesheet" href="/static/styles.css" />
</head>
<body class="sign-in-body">
<div class="sign-in-stage">
  <aside class="sign-in-banner">
    <div class="sign-in-banner-head">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5v-7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
        <path d="M12 12.2 20 8M12 12.2 4 8M12 12.2V20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      </svg>
      <strong>Asset Tracker</strong>
    </div>
    <p>Hardware and software licenses.</p>
    <ul class="sign-in-legend">
      <li><span class="status status-in-stock">In stock</span></li>
      <li><span class="status status-assigned">Assigned</span></li>
      <li><span class="status status-returned">Returned</span></li>
      <li><span class="status status-lost">Lost</span></li>
      <li><span class="status status-discarded">Discarded</span></li>
    </ul>
  </aside>
  <main class="sign-in-card" id="main">
    <h1>Sign in</h1>
    <p class="muted">Sign in to continue.</p>
    <% if (error) { %>
      <p class="error" role="alert" data-testid="sign-in-error"><%= error %></p>
    <% } %>
    <form method="post" action="/sign-in" class="form" data-testid="sign-in-form">
      <input type="hidden" name="next" value="<%= next %>" />
      <label>
        Username
        <input type="text" name="username" required autocomplete="username" value="<%= username %>" data-testid="sign-in-username" />
      </label>
      <label>
        Password
        <span class="password-field">
          <input type="password" name="password" required autocomplete="current-password" data-testid="sign-in-password" />
          <button type="button" class="password-toggle" data-testid="sign-in-password-toggle" aria-label="Show password" aria-pressed="false">
            <svg class="password-eye" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2.5 12S6.2 6.5 12 6.5 21.5 12 21.5 12 17.8 17.5 12 17.5 2.5 12 2.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.8"/>
            </svg>
            <svg class="password-eye-off" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M3.5 4.5 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M9.4 6.9A10 10 0 0 1 12 6.5c5.8 0 9.5 5.5 9.5 5.5a16 16 0 0 1-3.1 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M6.2 8.3C4.3 9.7 2.9 11.4 2.5 12S6.2 17.5 12 17.5c1.1 0 2.1-.2 3-.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M10 11.3a2.6 2.6 0 0 0 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </span>
      </label>
      <button type="submit" class="btn primary" data-testid="sign-in-submit">Sign in</button>
    </form>
  </main>
</div>
<script>
(function () {
  var button = document.querySelector('[data-testid="sign-in-password-toggle"]');
  var input = document.querySelector('[data-testid="sign-in-password"]');
  if (!button || !input) return;
  button.addEventListener('click', function () {
    var show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    button.setAttribute('aria-pressed', show ? 'true' : 'false');
    button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    input.focus();
  });
})();
</script>
</body>
</html>
