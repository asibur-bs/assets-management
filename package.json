{
  "name": "assets-management",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Internal asset-tracking system (poc)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "node scripts/run-tests.js",
    "test:db": "vitest run tests/db.test.js",
    "test:repo": "vitest run tests/assets-repo.test.js",
    "test:service": "vitest run tests/asset-service.test.js",
    "test:routes": "vitest run tests/routes.test.js",
    "test:views": "vitest run tests/views.test.js",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests vitest.config.js",
    "format:check": "prettier --check \"**/*.js\"",
    "secret-scan": "bash scripts/secret-scan.sh",
    "hooks:install": "lefthook install",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "ejs": "^3.1.10",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
